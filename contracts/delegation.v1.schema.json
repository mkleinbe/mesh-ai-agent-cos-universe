{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "mesh.cos.delegation.v1"},
    "delegation_id": {"type": "string"},
    "task_id": {"type": "string"},
    "delegating_agent": {"type": "string"},
    "accountable_agent": {"type": "string", "minLength": 1},
    "business_objective": {"type": "string"},
    "expected_outcome": {"type": "string"},
    "deliverable": {"type": "string"},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "priority": {"type": "string"},
    "authority_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "acceptance_test": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": ["string", "null"]},
    "contributing_agents": {"type": "array", "items": {"type": "string"}},
    "deadline": {"type": ["string", "null"]},
    "evidence_supplied": {"type": "array", "items": {"type": "string"}},
    "unresolved_evidence": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "permitted_actions": {"type": "array", "items": {"type": "string"}},
    "permitted_capabilities": {"type": "array", "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "approval_gates": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "next_check_at": {"type": ["string", "null"]},
    "escalation_condition": {"type": "string"}
  },
  "required": ["version","delegation_id","task_id","delegating_agent","accountable_agent","business_objective","expected_outcome","deliverable","success_criteria","priority","authority_level","acceptance_test","parent_task_id","contributing_agents","deadline","evidence_supplied","unresolved_evidence","constraints","permitted_actions","permitted_capabilities","prohibited_actions","approval_gates","dependencies","next_check_at","escalation_condition"]
}
