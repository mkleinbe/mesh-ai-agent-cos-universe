{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "mesh.cos.agent-event.v2"},
    "event_id": {"type": "string", "minLength": 1},
    "event_sequence": {"type": "integer", "minimum": 1},
    "event_timestamp_utc": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "event_category": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "actor_type": {"enum": ["AGENT", "HUMAN", "SERVICE", "SYSTEM"]},
    "actor_id": {"type": "string", "minLength": 1},
    "actor_role": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": ["string", "null"]},
    "parent_event_id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "authority_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "policy_rule_ids": {"type": "array", "items": {"type": "string"}},
    "capability_tool": {"type": "string", "minLength": 1},
    "target_resource": {"type": "string"},
    "source_system": {"type": "string", "minLength": 1},
    "input_summary": {"type": "string", "minLength": 1},
    "result_status": {"enum": ["SUCCESS", "FAILURE", "DENIED", "BLOCKED", "PARTIAL", "RETRY"]},
    "output_summary": {"type": "string", "minLength": 1},
    "before_state_ref": {"type": ["string", "null"]},
    "after_state_ref": {"type": ["string", "null"]},
    "evidence_references": {"type": "array", "items": {"type": "string"}},
    "approval_reference": {"type": ["string", "null"]},
    "human_approver": {"type": ["string", "null"]},
    "risk_severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "data_classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "error_code": {"type": ["string", "null"]},
    "error_summary": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "model_provider": {"type": ["string", "null"]},
    "model_id_version": {"type": ["string", "null"]},
    "skill_agent_version": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "retention_class": {"type": "string", "minLength": 1},
    "previous_event_hash": {"anyOf": [{"const": "GENESIS"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recorded_at_utc": {"type": "string", "minLength": 1},
    "canonical_record_ref": {"type": "string", "minLength": 1}
  },
  "required": [
    "version", "event_id", "event_sequence", "event_timestamp_utc", "event_type", "event_category", "action",
    "actor_type", "actor_id", "actor_role", "task_id", "correlation_id", "decision_id", "parent_event_id", "run_id",
    "authority_level", "policy_rule_ids", "capability_tool", "target_resource", "source_system", "input_summary",
    "result_status", "output_summary", "before_state_ref", "after_state_ref", "evidence_references", "approval_reference",
    "human_approver", "risk_severity", "data_classification", "error_code", "error_summary", "idempotency_key",
    "model_provider", "model_id_version", "skill_agent_version", "environment", "retention_class", "previous_event_hash",
    "event_hash", "recorded_at_utc", "canonical_record_ref"
  ]
}
