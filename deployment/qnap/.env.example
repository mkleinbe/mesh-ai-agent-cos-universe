# Never commit the real .env
MESH_COS_IMAGE=mesh-cos-mcp:4.0.0-qnap-candidate
TUNNEL_IMAGE=ghcr.io/openai/tunnel-client:v0.0.12
QNAP_MESH_ROOT=/share/REPLACE_WITH_VERIFIED_PATH/mesh-cos
MESH_UID=REPLACE_WITH_VERIFIED_UID
MESH_GID=REPLACE_WITH_VERIFIED_GID
MESH_CPU_LIMIT=1.0
MESH_MEMORY_LIMIT=1g
MESH_MEMORY_RESERVATION=512m
MESH_PIDS_LIMIT=128
MESH_LOG_MAX_SIZE=10m
MESH_LOG_MAX_FILES=5
MESH_COS_BRIDGE_TIMEOUT_MS=30000
MESH_COS_MAX_BRIDGE_QUEUE=32
CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE
CONTROL_PLANE_API_KEY=REPLACE_AT_DEPLOYMENT
