{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "mesh.cos.agent-record.v1"},
    "agent_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "parent_agent_id": {"type": ["string", "null"]},
    "agent_type": {"enum": ["executive", "controller", "specialist", "worker", "reviewer", "operations"]},
    "status": {"enum": ["SHADOW", "ACTIVE", "WATCH", "RESTRICTED", "QUARANTINED", "RETIRED"]},
    "agent_version": {"type": "string", "minLength": 1},
    "accountable_domain": {"type": "string", "minLength": 1},
    "authoritative_sources": {"type": "array", "items": {"type": "string"}},
    "allowed_sources": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "input_contracts": {"type": "array", "items": {"type": "string"}},
    "output_contracts": {"type": "array", "items": {"type": "string"}},
    "permitted_actions": {"type": "array", "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "decision_authority": {"type": "integer", "minimum": 0, "maximum": 5},
    "decision_authority_policy": {"type": "string"},
    "required_approvals": {"type": "array", "items": {"type": "string"}},
    "delegation_permissions": {"type": "array", "items": {"type": "string"}},
    "max_delegation_depth": {"type": "integer", "minimum": 0, "maximum": 2},
    "normal_SLA": {"type": "string"},
    "performance_policy": {"type": "string"},
    "confidentiality_class": {"type": "string"},
    "runtime_health": {"enum": ["SHADOW", "ACTIVE", "WATCH", "RESTRICTED", "QUARANTINED", "RETIRED"]}
  },
  "required": [
    "version", "agent_id", "display_name", "role", "description", "parent_agent_id", "agent_type", "status", "agent_version",
    "accountable_domain", "authoritative_sources", "allowed_sources", "skills", "tools", "input_contracts", "output_contracts",
    "permitted_actions", "prohibited_actions", "decision_authority", "decision_authority_policy", "required_approvals",
    "delegation_permissions", "max_delegation_depth", "normal_SLA", "performance_policy", "confidentiality_class", "runtime_health"
  ]
}
