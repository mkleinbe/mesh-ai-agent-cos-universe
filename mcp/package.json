{
  "name": "@meshdigitalio/mesh-cos-mcp",
  "version": "4.0.0",
  "private": true,
  "description": "Bundled local stdio MCP transport for the governed Mesh AI Chief of Staff runtime",
  "type": "module",
  "bin": {
    "mesh-cos-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js",
    "smoke": "node scripts/smoke-test.mjs",
    "security": "npm audit --audit-level=high",
    "check": "npm run build && npm run test && npm run smoke && npm run security"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.30",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
