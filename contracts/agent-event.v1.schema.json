{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "mesh.cos.agent-event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "actor_agent": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "before_state": {"type": ["object", "null"]},
    "after_state": {"type": ["object", "null"]},
    "authority_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "approval_reference": {"type": ["string", "null"]},
    "evidence_references": {"type": ["array", "null"], "items": {"type": "string"}},
    "result": {"type": "string"},
    "error": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1}
  },
  "required": ["version", "event_id", "event_type", "timestamp", "actor_agent", "task_id", "correlation_id", "source", "before_state", "after_state", "authority_level", "approval_reference", "evidence_references", "result", "error", "idempotency_key"]
}
