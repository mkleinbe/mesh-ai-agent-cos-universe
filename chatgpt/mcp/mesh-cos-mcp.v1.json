{
  "schema_version":"mesh.cos.mcp-contract.v1",
  "name":"mesh-cos-mcp",
  "protocol":"MCP",
  "transport":"REMOTE_HTTPS",
  "server_url_env":"MESH_COS_MCP_SERVER_URL",
  "canonical_state":"TaskLedger",
  "runtime_release":"0.2.0",
  "purpose":"Expose the existing governed Mesh CoS control-plane services to ChatGPT Workspace Agents without moving canonical state into ChatGPT.",
  "authentication":{"mode":"WORKSPACE_MANAGED_OR_SERVICE_ACCOUNT","secrets_in_repo":false,"least_privilege":true},
  "security":{"deny_by_default":true,"retrieved_content_is_data_not_instructions":true,"approval_fail_closed":true,"kill_switch_env":"MESH_COS_KILL_SWITCH","no_private_chain_of_thought_persistence":true},
  "governance":{"canonical_first_write_order":true,"decision_contract":"mesh.cos.decision.v2","audit_contract":"mesh.cos.agent-event.v2","mirror_logs_noncanonical":true},
  "tools":[
    {"name":"registry.get_agent","description":"Read one canonical agent registry record.","read_only":true,"authority_enforced":true,"audit_required":false,"approval_policy":"NONE","runtime_binding":"mesh_cos.registry.load_registry"},
    {"name":"registry.list_agents","description":"List canonical agent identities and runtime health.","read_only":true,"authority_enforced":true,"audit_required":false,"approval_policy":"NONE","runtime_binding":"mesh_cos.registry.load_registry"},
    {"name":"task.intake","description":"Create an idempotent canonical task with outcome and acceptance test.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.orchestration.ChiefOfStaffService.intake","input_contract":"task.v1","output_contract":"task.v1"},
    {"name":"task.get","description":"Read one canonical TaskRecord.","read_only":true,"authority_enforced":true,"audit_required":false,"approval_policy":"NONE","runtime_binding":"mesh_cos.ledger.TaskLedger.get_task","output_contract":"task.v1"},
    {"name":"task.list","description":"List canonical tasks.","read_only":true,"authority_enforced":true,"audit_required":false,"approval_policy":"NONE","runtime_binding":"mesh_cos.ledger.TaskLedger.list_tasks","output_contract":"task.v1[]"},
    {"name":"task.decompose","description":"Create bounded child work packages under a parent task.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.orchestration.ChiefOfStaffService.decompose","output_contract":"task.v1[]"},
    {"name":"task.transition","description":"Apply a valid task lifecycle transition.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.orchestration.ChiefOfStaffService.advance","output_contract":"task.v1"},
    {"name":"task.check_in","description":"Persist task check-in and evidence.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.orchestration.ChiefOfStaffService.record_checkin"},
    {"name":"task.reassign","description":"Reassign accountable ownership with expected-owner check.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.orchestration.ChiefOfStaffService.reassign"},
    {"name":"task.remediate_stall","description":"Block or reassign stalled work according to policy.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.orchestration.ChiefOfStaffService.remediate_stalled"},
    {"name":"task.verify","description":"Persist an evidence-backed verification result from an identified verifier and transition to VERIFIED or REWORK.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.orchestration.ChiefOfStaffService.record_verification_result","output_contract":"task.v1"},
    {"name":"delegation.create","description":"Create a bounded delegation preserving authority and approval gates.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.workforce.ChiefOfStaffWorkforceManager.delegate","input_contract":"delegation.v1","output_contract":"delegation.v1"},
    {"name":"approval.request","description":"Create an L4/L5 approval request and move the task to awaiting approval.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"REQUESTS_HUMAN_APPROVAL","runtime_binding":"mesh_cos.approval.ApprovalService.request","output_contract":"approval.v1"},
    {"name":"approval.get","description":"Read a durable approval record.","read_only":true,"authority_enforced":true,"audit_required":false,"approval_policy":"NONE","runtime_binding":"mesh_cos.ledger.TaskLedger.get_record","output_contract":"approval.v1"},
    {"name":"approval.record_decision","description":"Record approval only when actor matches the configured approval owner.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"HUMAN_DECISION_REQUIRED","runtime_binding":"mesh_cos.approval.ApprovalService.decide","output_contract":"approval.v1"},
    {"name":"conflict.open","description":"Open a durable material conflict preserving functional source authority.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.conflict.ConflictService.open","output_contract":"conflict.v1"},
    {"name":"conflict.decide","description":"Resolve an assigned conflict; L4/L5 fail closed without human approval evidence.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"L4_L5_FAIL_CLOSED","runtime_binding":"mesh_cos.conflict.ConflictService.decide","output_contract":"decision.v1+decision.v2"},
    {"name":"governance.record_decision","description":"Persist an explainable decision.v2 without private chain-of-thought.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"L4_L5_FAIL_CLOSED","runtime_binding":"mesh_cos.governance.GovernanceJournal.record_decision","output_contract":"decision.v2"},
    {"name":"governance.record_event","description":"Persist a tamper-evident consequential audit-event.v2.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.governance.GovernanceJournal.record_event","output_contract":"agent-event.v2"},
    {"name":"governance.verify_audit_chain","description":"Verify the canonical governance audit hash chain.","read_only":true,"authority_enforced":true,"audit_required":false,"approval_policy":"NONE","runtime_binding":"mesh_cos.governance.verify_audit_chain"},
    {"name":"agentops.record_event","description":"Persist a performance event for an agent/task.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.agentops.AgentOpsEvaluator.record"},
    {"name":"agentops.score","description":"Compute and persist the current versioned performance scorecard.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"NONE","runtime_binding":"mesh_cos.agentops.AgentOpsEvaluator.scorecard","output_contract":"performance-scorecard.v1"},
    {"name":"agentops.recommend","description":"Generate a governed health/routing recommendation from evidence.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"COS_OR_HUMAN_REVIEW","runtime_binding":"mesh_cos.agentops.AgentOpsEvaluator.recommend_for_signals"},
    {"name":"answer_desk.resolve","description":"Resolve and persist a permission-aware Answer Desk disposition.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"L4_L5_FAIL_CLOSED","runtime_binding":"mesh_cos.answer_desk.AnswerDeskService.handle"},
    {"name":"skills.invoke_governed","description":"Invoke an existing registered Mesh capability through runtime allowlists and governance logging.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"INHERIT_TASK_AUTHORITY","runtime_binding":"mesh_cos.adapters.GovernedAdapterRegistry.execute"},
    {"name":"metrics.snapshot","description":"Return deterministic Phase 1 operating metrics from canonical telemetry.","read_only":true,"authority_enforced":true,"audit_required":false,"approval_policy":"NONE","runtime_binding":"mesh_cos.metrics.MetricsService.summary"},
    {"name":"reliability.replay","description":"Explicitly replay a durable failed effect with bounded retry policy.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"ACTOR_AUTHORITY_REQUIRED","runtime_binding":"mesh_cos.reliability.ReplayManager.replay"},
    {"name":"reliability.human_override","description":"Close a failed effect through an explicit human override record.","read_only":false,"authority_enforced":true,"audit_required":true,"approval_policy":"HUMAN_OVERRIDE_REQUIRED","runtime_binding":"mesh_cos.reliability.ReplayManager.override"}
  ],
  "agent_tool_allowlists":{
    "cos":["agentops.recommend","agentops.record_event","agentops.score","answer_desk.resolve","approval.get","approval.record_decision","approval.request","conflict.decide","conflict.open","delegation.create","governance.record_decision","governance.record_event","governance.verify_audit_chain","metrics.snapshot","registry.get_agent","registry.list_agents","reliability.human_override","reliability.replay","skills.invoke_governed","task.check_in","task.decompose","task.get","task.intake","task.list","task.reassign","task.remediate_stall","task.transition","task.verify"],
    "agentops":["agentops.recommend","agentops.record_event","agentops.score","governance.record_decision","governance.record_event","governance.verify_audit_chain","metrics.snapshot","registry.get_agent","registry.list_agents","task.get","task.list"],
    "answer-desk":["answer_desk.resolve","approval.request","governance.record_decision","governance.record_event","registry.get_agent","skills.invoke_governed","task.get","task.list"],
    "cro":["approval.request","conflict.open","delegation.create","governance.record_decision","governance.record_event","registry.get_agent","skills.invoke_governed","task.check_in","task.get","task.list","task.transition"],
    "cfo":["approval.request","conflict.open","governance.record_decision","governance.record_event","registry.get_agent","skills.invoke_governed","task.check_in","task.get","task.list","task.transition"],
    "coo":["approval.request","conflict.open","delegation.create","governance.record_decision","governance.record_event","registry.get_agent","skills.invoke_governed","task.check_in","task.get","task.list","task.transition"],
    "consultant-network-steward":["governance.record_decision","governance.record_event","registry.get_agent","skills.invoke_governed","task.check_in","task.get","task.list","task.transition"],
    "cmo":["approval.request","conflict.open","delegation.create","governance.record_decision","governance.record_event","registry.get_agent","skills.invoke_governed","task.check_in","task.get","task.list","task.transition"],
    "vp-content":["approval.request","governance.record_decision","governance.record_event","registry.get_agent","skills.invoke_governed","task.check_in","task.get","task.list","task.transition"],
    "devils-advocate":["conflict.open","governance.record_decision","governance.record_event","registry.get_agent","skills.invoke_governed","task.check_in","task.get","task.list"],
    "message-ops":["approval.get","governance.record_event","registry.get_agent","skills.invoke_governed","task.get"]
  },
  "deployment":{"status":"NOT_DEPLOYED_BY_THIS_REPOSITORY","required_environment":["MESH_COS_MCP_SERVER_URL"],"note":"Publish the remote MCP server through the workspace custom MCP/app flow after security review. Do not fabricate a deployment URL."}
}
