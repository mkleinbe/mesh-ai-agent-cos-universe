{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "mesh.cos.decision.v2"},
    "decision_id": {"type": "string", "minLength": 1},
    "decided_at_utc": {"type": "string", "minLength": 1},
    "decision_status": {"enum": ["PROPOSED", "PENDING_APPROVAL", "DECIDED", "REJECTED", "SUPERSEDED", "REVERSED"]},
    "decision_type": {"type": "string", "minLength": 1},
    "decision_title": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "agent_role": {"type": "string", "minLength": 1},
    "decision_owner": {"type": "string", "minLength": 1},
    "authority_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "human_approval_required": {"type": "boolean"},
    "approval_reference": {"type": ["string", "null"]},
    "human_approver": {"type": ["string", "null"]},
    "decision": {"type": "string", "minLength": 1},
    "disposition": {"type": "string", "minLength": 1},
    "decision_basis_summary": {"type": "string", "minLength": 1},
    "evidence_references": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_systems": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "alternatives_considered": {"type": "array", "items": {"type": "string"}},
    "selection_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]}]},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "affected_entities": {"type": "array", "items": {"type": "string"}},
    "reversibility": {"enum": ["REVERSIBLE", "PARTIALLY_REVERSIBLE", "IRREVERSIBLE"]},
    "reversal_condition": {"type": "string", "minLength": 1},
    "policy_rule_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "model_provider": {"type": ["string", "null"]},
    "model_id_version": {"type": ["string", "null"]},
    "prompt_template_version": {"type": ["string", "null"]},
    "skill_agent_version": {"type": "string", "minLength": 1},
    "data_classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "outcome_validation": {"type": "string", "minLength": 1},
    "outcome_status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "VALIDATED", "FAILED", "UNKNOWN"]},
    "supersedes_decision_id": {"type": ["string", "null"]},
    "superseded_by_decision_id": {"type": ["string", "null"]},
    "review_due_at_utc": {"type": ["string", "null"]},
    "retention_class": {"type": "string", "minLength": 1},
    "canonical_record_ref": {"type": "string", "minLength": 1},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recorded_at_utc": {"type": "string", "minLength": 1}
  },
  "required": [
    "version", "decision_id", "decided_at_utc", "decision_status", "decision_type", "decision_title",
    "task_id", "correlation_id", "agent_id", "agent_role", "decision_owner", "authority_level",
    "human_approval_required", "approval_reference", "human_approver", "decision", "disposition",
    "decision_basis_summary", "evidence_references", "source_systems", "alternatives_considered",
    "selection_criteria", "confidence", "risk_level", "affected_entities", "reversibility",
    "reversal_condition", "policy_rule_ids", "model_provider", "model_id_version", "prompt_template_version",
    "skill_agent_version", "data_classification", "outcome_validation", "outcome_status",
    "supersedes_decision_id", "superseded_by_decision_id", "review_due_at_utc", "retention_class",
    "canonical_record_ref", "record_hash", "recorded_at_utc"
  ]
}
