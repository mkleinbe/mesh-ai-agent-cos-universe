# Reference only. mesh-cos-mcp-prepare.sh generates the staged .env.runtime automatically.
# Deployment scripts self-resolve their versioned release root; QNAP_SCRIPT_ROOT is intentionally omitted.
# QNAP_RELEASES_ROOT is the stable operator root and is not a release-specific script location.
# No tunnel key, Slack bot token, or Slack approver user ID is stored in this environment file.
# Governed approval collaboration is sent by the installed ChatGPT Enterprise AI Agent Slack bot.
# Approval ingress is a ChatGPT-native Slack new-message trigger, not QNAP Socket Mode.
MESH_COS_DEPLOYMENT_RELEASE=4.2.0
MESH_COS_IMAGE=mesh-cos-mcp:qnap-v4.2.0
MESH_COS_IMAGE_ID=sha256:GENERATED_BY_PREPARE
TUNNEL_IMAGE=ghcr.io/openai/tunnel-client@sha256:GENERATED_BY_PREPARE
TUNNEL_IMAGE_ID=sha256:GENERATED_BY_PREPARE
OPENAI_TUNNEL_IMAGE_SOURCE=ghcr.io/openai/tunnel-client:v0.0.12
QNAP_RELEASES_ROOT=/share/Docker/cos-mcp/releases
QNAP_APP_ROOT=/share/Docker/cos-mcp
QNAP_MESH_ROOT=/share/Docker/cos-mcp/state
QNAP_BACKUP_ROOT="/share/QNAP NAS/Mike Home/MCP/CoS/Backups"
QNAP_TUNNEL_API_KEY_FILE=/share/Docker/cos-mcp/secrets/openai-tunnel-runtime-key
QNAP_SLACK_APPROVER_USER_ID_FILE=/share/Docker/cos-mcp/secrets/slack-approver-user-id
QNAP_SLACK_BOT_TOKEN_FILE=/share/Docker/cos-mcp/secrets/slack-bot-token
MESH_COS_SLACK_AGENT_OPS_CHANNEL_ID=C0BRL4GCL3A
MESH_COS_SLACK_APPROVER_PRINCIPAL=michael
MESH_COS_SLACK_APP_ID=A0B49RNF4K0
MESH_COS_SLACK_HITL_MODE=CHATGPT_NATIVE_EVENT_TRIGGER
MESH_COS_DOCKER_CONFIG=/share/Docker/cos-mcp/.docker-cli
MESH_COS_LOG_ROOT=/share/Docker/cos-mcp/logs/deployment
MESH_UID=65532
MESH_GID=65532
MESH_CPU_LIMIT=2.0
MESH_MEMORY_LIMIT=24g
MESH_MIN_FREE_BYTES=21474836480
MESH_LOG_MAX_SIZE=10m
MESH_LOG_MAX_FILES=5
MESH_COS_BRIDGE_TIMEOUT_MS=30000
MESH_COS_MAX_BRIDGE_QUEUE=32
CONTROL_PLANE_TUNNEL_ID=tunnel_REPLACE_WITH_32_HEX_CHARACTERS