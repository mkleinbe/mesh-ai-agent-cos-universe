{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "mesh.cos.delegation.v1"},
    "delegation_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": ["string", "null"]},
    "delegating_agent": {"type": "string", "minLength": 1},
    "accountable_agent": {"type": "string", "minLength": 1},
    "contributing_agents": {"type": "array", "items": {"type": "string"}},
    "business_objective": {"type": "string", "minLength": 1},
    "expected_outcome": {"type": "string", "minLength": 1},
    "deliverable": {"type": "string", "minLength": 1},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "deadline": {"type": ["string", "null"]},
    "priority": {"type": "string", "minLength": 1},
    "evidence_supplied": {"type": "array", "items": {"type": "string"}},
    "unresolved_evidence": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "authority_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "permitted_actions": {"type": "array", "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "approval_gates": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "next_check_at": {"type": ["string", "null"]},
    "escalation_condition": {"type": "string"},
    "acceptance_test": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "ACTIVE", "COMPLETED", "CANCELLED", "SUPERSEDED"]},
    "created_at": {"type": "string"},
    "accepted_at": {"type": ["string", "null"]},
    "completed_at": {"type": ["string", "null"]}
  },
  "required": [
    "version", "delegation_id", "task_id", "parent_task_id", "delegating_agent", "accountable_agent", "contributing_agents",
    "business_objective", "expected_outcome", "deliverable", "success_criteria", "deadline", "priority", "evidence_supplied",
    "unresolved_evidence", "constraints", "authority_level", "permitted_actions", "prohibited_actions", "approval_gates", "dependencies",
    "next_check_at", "escalation_condition", "acceptance_test", "status", "created_at", "accepted_at", "completed_at"
  ]
}
