{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "mesh.cos.task.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": ["string", "null"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "expected_outcome": {"type": "string", "minLength": 1},
    "requested_by": {"type": "string", "minLength": 1},
    "executive_sponsor": {"type": "string", "minLength": 1},
    "accountable_agent": {"type": "string", "minLength": 1},
    "contributors": {"type": "array", "items": {"type": "string"}},
    "decision_owner": {"type": "string", "minLength": 1},
    "priority": {"type": "string", "minLength": 1},
    "status": {"enum": ["INTAKE", "TRIAGED", "PLANNED", "ASSIGNED", "IN_PROGRESS", "BLOCKED", "AWAITING_INPUT", "AWAITING_APPROVAL", "QA", "REWORK", "READY_FOR_DECISION", "READY_FOR_ACTION", "COMPLETED", "VERIFIED", "CLOSED", "CANCELLED"]},
    "authority_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "source_references": {"type": "array", "items": {"type": "string"}},
    "evidence_status": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "deliverable_contract": {"type": "string"},
    "due_at": {"type": ["string", "null"]},
    "next_check_at": {"type": ["string", "null"]},
    "success_metrics": {"type": "array", "items": {"type": "string"}},
    "acceptance_test": {"type": "string", "minLength": 1},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "approval_status": {"type": "string"},
    "approval_owner": {"type": ["string", "null"]},
    "slack_channel_id": {"type": ["string", "null"]},
    "slack_thread_ts": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "started_at": {"type": ["string", "null"]},
    "completed_at": {"type": ["string", "null"]},
    "verified_at": {"type": ["string", "null"]},
    "closed_at": {"type": ["string", "null"]},
    "outcome": {"type": ["string", "null"]},
    "outcome_evidence": {"type": "array", "items": {"type": "string"}},
    "rework_count": {"type": "integer", "minimum": 0},
    "escalation_count": {"type": "integer", "minimum": 0},
    "human_touches": {"type": "integer", "minimum": 0},
    "CEO_touches": {"type": "integer", "minimum": 0},
    "ceo_time_avoided_estimate_minutes": {"type": ["integer", "null"], "minimum": 0},
    "ceo_time_avoided_methodology": {"type": ["string", "null"]},
    "audit_events": {"type": "array", "items": {"type": "string"}},
    "superseded_by_task_id": {"type": ["string", "null"]}
  },
  "required": [
    "version", "task_id", "parent_task_id", "correlation_id", "objective", "expected_outcome", "requested_by",
    "executive_sponsor", "accountable_agent", "contributors", "decision_owner", "priority", "status", "authority_level",
    "source_references", "evidence_status", "assumptions", "risks", "constraints", "dependencies", "deliverable_contract",
    "due_at", "next_check_at", "success_metrics", "acceptance_test", "blockers", "approval_status", "approval_owner",
    "slack_channel_id", "slack_thread_ts", "created_at", "started_at", "completed_at", "verified_at", "closed_at", "outcome",
    "outcome_evidence", "rework_count", "escalation_count", "human_touches", "CEO_touches",
    "ceo_time_avoided_estimate_minutes", "ceo_time_avoided_methodology", "audit_events", "superseded_by_task_id"
  ]
}
